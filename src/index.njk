---
layout: layouts/base.njk
title: "Abhishek Dahal — Web Developer"
permalink: "/"
---

{# =========================================================================
   1. HERO SECTION
   ========================================================================= #}
<section class="editorial-section" aria-labelledby="hero-title">
  <div class="hero-layout">
    <div class="hero-content">
      <div class="eyebrow">
        <span class="dot-cobalt" aria-hidden="true"></span>
        <span>{{ site.hero.eyebrow }}</span>
      </div>

      <h1 id="hero-title" class="hero-headline">
        {{ site.hero.headline }}
      </h1>

      <p class="hero-lead">
        {{ site.hero.lead }}
      </p>

      <div class="hero-actions-row">
        <a href="#work" class="hero-link">
          <span>Explore my work</span>
          <span aria-hidden="true">↓</span>
        </a>

        <a href="#contact" class="hero-link hero-link--cobalt">
          <span>Get in touch</span>
          <span aria-hidden="true">↗</span>
        </a>

        {# <div class="hero-status-tag">
          <span class="dot-green" aria-hidden="true"></span>
          <span>{{ site.hero.status }}</span>
        </div> #}
      </div>
    </div>

    <div class="hero-photo">
      <img
        src="{{ site.hero.profilePhoto }}"
        alt="Portrait"
        class="hero-profile-image"
      />
    </div>
  </div>
</section>


{# =========================================================================
   2. SELECTED WORK SECTION
   ========================================================================= #}
<section id="work" class="editorial-section" data-reveal-early aria-labelledby="work-title">
  <div class="section-intro-bar">
    <div>
      <span class="eyebrow">Selected work</span>
      <h2 id="work-title" class="section-headline">Recent Projects</h2>
    </div>
    <p class="section-summary-text">
      A selection of projects I've worked on.
    </p>
  </div>

  <div class="work-grid">
    {% for project in collections.projects %}
      {% include "components/project-card.njk" %}
    {% endfor %}
  </div>
</section>

{# =========================================================================
   3. ABOUT SECTION (Narrative + Structured Skills Matrix)
   ========================================================================= #}
<section id="about" class="editorial-section" aria-labelledby="about-title">
  <div class="about-grid">
    <!-- Left Column: Narrative -->
    <div class="about-narrative">
      <span class="eyebrow">{{ site.about.heading }}</span>
      <h2 id="about-title" class="about-headline">{{ site.about.leadHeading }}</h2>
      <p class="about-text">
        {{ site.about.text }}
      </p>
      <p class="about-interests">
        <span class="eyebrow">Beyond the work</span>
        {{ site.about.interests }}
      </p>
    </div>

    <!-- Right Column: Skills Matrix -->
    <div class="skills-matrix" aria-label="Technical skill areas">
      {% for skill in site.skills %}
        <div class="skills-row">
          <span class="skills-cat-label">{{ skill.category }}</span>
          <p class="skills-cat-items">{{ skill.items }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{# =========================================================================
   4. EDUCATION SECTION
   ========================================================================= #}
<section id="education" class="editorial-section" aria-labelledby="education-title">
  <div class="experience-max">
    <span class="eyebrow">Academic background</span>
    <h2 id="education-title" class="section-headline" style="margin-bottom: 2.5rem;">Education</h2>

    <div class="experience-list">
      {% for item in site.education %}
        <article class="experience-item">
          <div>
            <h3 class="experience-company">{{ item.degree }}</h3>
            <p class="experience-role">{{ item.institution }}</p>
          </div>
          <div>
            <p class="education-result">{{ item.result }}</p>
            <p class="experience-desc">{{ item.year }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{# =========================================================================
   5. EXPERIENCE SECTION
   ========================================================================= #}
<section id="experience" class="editorial-section" aria-labelledby="experience-title">
  <div class="experience-max">
    <span class="eyebrow">Where I've worked</span>
    <h2 id="experience-title" class="section-headline" style="margin-bottom: 2.5rem;">Work Experience</h2>

    <div class="experience-list">
      {% for job in site.experience %}
        <article class="experience-item">
          <div>
            <h3 class="experience-company">{{ job.company }}</h3>
            <p class="experience-role">{{ job.role }}</p>
          </div>
          <div>
            <p class="experience-desc">{{ job.description }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{# =========================================================================
   6. CONTACT SECTION
   ========================================================================= #}
<section id="contact" class="editorial-section" style="border-bottom: none;" aria-labelledby="contact-title">
  <div class="contact-banner">
    <div class="contact-content">
      <div class="eyebrow">
        <span class="dot-cobalt" aria-hidden="true"></span>
        <span>Direct Channels</span>
      </div>

      <h2 id="contact-title" class="contact-headline">
        {{ site.contact.headline }}
      </h2>

      <p class="contact-text">
        {{ site.contact.text }}
      </p>

      <div class="contact-buttons-row">
        <a href="mailto:{{ site.author.email }}" class="btn-contact btn-contact--primary">
          <span>{{ site.author.emailDisplay }}</span>
          <span aria-hidden="true">↗</span>
        </a>

        <a href="{{ site.author.linkedIn }}" target="_blank" rel="noopener noreferrer" class="btn-contact btn-contact--outline">
          <span>LinkedIn</span>
          <span aria-hidden="true">↗</span>
        </a>

        <a href="{{ site.author.github }}" target="_blank" rel="noopener noreferrer" class="btn-contact btn-contact--outline">
          <span>GitHub</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
