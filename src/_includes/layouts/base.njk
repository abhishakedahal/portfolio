<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  {% set pageTitle = title or site.siteTitle %}
  {% set pageDescription = description or site.description %}
  {% set pageUrl = site.url ~ (page.url or "/") %}
  {% set socialImage = (image or site.socialImage) %}

  <title>{{ pageTitle }}</title>
  
  {# Meta Description #}
  <meta name="description" content="{{ pageDescription }}">
  <meta name="author" content="{{ site.author.name }}">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#fcf9f6">

  {# Canonical URL #}
  <link rel="canonical" href="{{ pageUrl }}">
  <link rel="sitemap" type="application/xml" href="{{ site.url }}/sitemap.xml">
  <link rel="ard" href="/.well-known/ard.json">

  {# Open Graph / Social Sharing #}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ site.url }}{{ socialImage }}">
  <meta property="og:image:alt" content="{{ site.name }} profile image">

  {# Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ site.url }}{{ socialImage }}">
  <meta name="twitter:image:alt" content="{{ site.name }} profile image">

  <style>
    :root{--bg-surface:#fff;--text-on-surface:#000;--text-secondary:#404040;--border-rule:#e6e2da;--font-sans:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;--font-serif:Newsreader,Georgia,serif}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{font-family:var(--font-sans);line-height:1.6;color:var(--text-on-surface);background:var(--bg-surface);-webkit-text-size-adjust:100%}
    body{min-height:100vh;background:var(--bg-surface);color:var(--text-on-surface)}
    .site-header{position:sticky;top:0;z-index:50;background:rgba(252,249,246,.92);border-bottom:1px solid var(--border-rule)}
    .site-header__inner{display:flex;align-items:center;justify-content:space-between;height:4.25rem}
    .canvas-container{width:100%;max-width:72rem;margin-inline:auto;padding-inline:1.25rem}
    .site-wordmark{font-size:1.125rem;font-weight:600;letter-spacing:-.015em;color:var(--text-on-surface);text-decoration:none}
    .site-nav{display:flex;align-items:center;gap:1.75rem}.site-nav__list{display:flex;list-style:none;align-items:center;gap:1.75rem}
    .site-nav__link{font-size:.875rem;font-weight:500;color:var(--text-secondary)}
    .hero-layout{display:grid;grid-template-columns:1fr;grid-template-areas:"photo" "content";gap:3rem;align-items:center}.hero-content{grid-area:content;max-width:52rem;display:flex;flex-direction:column;gap:1.5rem}
    .hero-headline{font-family:var(--font-serif);font-size:clamp(2.35rem,5.5vw,3.85rem);font-weight:400;line-height:1.12}.hero-lead{font-size:1.125rem;line-height:1.8;color:var(--text-secondary)}
    .hero-photo{grid-area:photo;width:16rem;height:16rem;max-width:100%;justify-self:center;overflow:hidden;border-radius:50%;padding:.4rem;background:var(--bg-surface)}.hero-profile-image{display:block;width:100%;height:100%;border-radius:50%;object-fit:contain}
    @media (max-width:767px){.hero-photo{width:min(16rem,calc(100vw - 2.5rem));height:min(16rem,calc(100vw - 2.5rem))}}
    @media (min-width:768px){.canvas-container{padding-inline:4rem}.hero-layout{grid-template-columns:2fr .5fr;grid-template-areas:"content photo";gap:2rem}}
  </style>

  {# Google Fonts: Newsreader & Inter. Keep the request off the critical path. #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"></noscript>

  {# Stylesheet #}
  <link rel="preload" href="/assets/css/style.css?v=4" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/assets/css/style.css?v=4"></noscript>

  {# Crawlable favicon for search results and browser tabs #}
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/images/optimized/favicon-96.png?v=1">
  <link rel="apple-touch-icon" sizes="96x96" href="/assets/images/optimized/favicon-96.png?v=1">

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZRHVSWL39E"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-ZRHVSWL39E');
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "{{ site.url }}/#person",
          "name": "{{ site.author.name }}",
          "url": "{{ site.url }}/",
          "image": "{{ site.url }}{{ site.socialImage }}",
          "jobTitle": "{{ site.title }}",
          "sameAs": [
            "{{ site.author.linkedIn }}",
            "{{ site.author.github }}"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "{{ site.url }}/#website",
          "url": "{{ site.url }}/",
          "name": "{{ site.name }}",
          "description": "{{ site.description }}",
          "publisher": {
            "@id": "{{ site.url }}/#person"
          }
        },
        {
          "@type": "WebPage",
          "@id": "{{ pageUrl }}#webpage",
          "url": "{{ pageUrl }}",
          "name": "{{ pageTitle }}",
          "description": "{{ pageDescription }}",
          "isPartOf": {
            "@id": "{{ site.url }}/#website"
          },
          "about": {
            "@id": "{{ site.url }}/#person"
          }
        }
      ]
    }
  </script>
</head>
<body id="top"{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  {% include "components/header.njk" %}

  <main id="main-content" class="canvas-container">
    {{ content | safe }}
  </main>

  {% include "components/footer.njk" %}

  <div class="pacman-ghost" aria-hidden="true">
    <span class="pacman-ghost__eye"><span class="pacman-ghost__pupil"></span></span>
    <span class="pacman-ghost__eye"><span class="pacman-ghost__pupil"></span></span>
  </div>

  <script defer src="https://unpkg.com/lenis@1.3.8/dist/lenis.min.js"></script>
  <script defer src="/assets/js/main.js?v=2"></script>
</body>
</html>
