<article class="work-card" data-platforms="{{ project.data.technologies | join(',') }}">
  <div>
    <!-- Browser Mockup Frame -->
    <div class="browser-frame">
      <div class="browser-bar">
        <span class="browser-dot" aria-hidden="true"></span>
        <span class="browser-dot" aria-hidden="true"></span>
        <span class="browser-dot" aria-hidden="true"></span>
        <span class="browser-address">{{ project.data.previewUrl or "project.preview" }}</span>
        {% if project.data.liveUrl %}
          <span class="browser-action-indicator" aria-hidden="true">Visit site ↗</span>
        {% endif %}
      </div>
      <div class="browser-screen-wrapper">
        {% if project.data.thumbnail %}
          {% set imageStem = project.data.thumbnail | imageStem %}
          <picture>
            <source type="image/avif" srcset="/assets/images/optimized/projects/{{ imageStem }}-400.avif?v=1 400w, /assets/images/optimized/projects/{{ imageStem }}-680.avif?v=1 680w, /assets/images/optimized/projects/{{ imageStem }}-900.avif?v=1 900w, /assets/images/optimized/projects/{{ imageStem }}-1200.avif?v=1 1200w" sizes="(max-width: 767px) calc(100vw - 3.5rem), (max-width: 1152px) 40vw, 517px">
            <source type="image/webp" srcset="/assets/images/optimized/projects/{{ imageStem }}-400.webp?v=1 400w, /assets/images/optimized/projects/{{ imageStem }}-680.webp?v=1 680w, /assets/images/optimized/projects/{{ imageStem }}-900.webp?v=1 900w, /assets/images/optimized/projects/{{ imageStem }}-1200.webp?v=1 1200w" sizes="(max-width: 767px) calc(100vw - 3.5rem), (max-width: 1152px) 40vw, 517px">
            <img src="/assets/images/optimized/projects/{{ imageStem }}-900.jpg?v=1" srcset="/assets/images/optimized/projects/{{ imageStem }}-400.jpg?v=1 400w, /assets/images/optimized/projects/{{ imageStem }}-680.jpg?v=1 680w, /assets/images/optimized/projects/{{ imageStem }}-900.jpg?v=1 900w, /assets/images/optimized/projects/{{ imageStem }}-1200.jpg?v=1 1200w" sizes="(max-width: 767px) calc(100vw - 3.5rem), (max-width: 1152px) 40vw, 517px" alt="{{ project.data.thumbnailAlt or project.data.title }}" class="browser-screen-img" loading="lazy" width="800" height="450" decoding="async">
          </picture>
        {% else %}
          <div class="browser-screen-fallback">
            Project Preview
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Content -->
    <div class="work-card-content">
      {% if project.data.technologies and project.data.technologies.length > 0 %}
        <div class="tech-pills-row" aria-label="Technologies used">
          {% for tech in project.data.technologies %}
          <span class="tech-pill{% if tech == 'Webflow' %} tech-pill--webflow{% elif tech == 'WordPress' %} tech-pill--wordpress{% elif tech == 'WooCommerce' %} tech-pill--woocommerce{% elif tech == 'OpenCart' %} tech-pill--opencart{% endif %}">
            {% if tech == 'Webflow' %}
              <span class="tech-pill-logo tech-pill-logo--webflow" aria-hidden="true">W</span>
            {% elif tech == 'WordPress' %}
              <span class="tech-pill-logo tech-pill-logo--wordpress" aria-hidden="true">W</span>
            {% elif tech == 'WooCommerce' %}
              <span class="tech-pill-logo tech-pill-logo--woocommerce" aria-hidden="true">W</span>
            {% elif tech == 'OpenCart' %}
              <span class="tech-pill-logo tech-pill-logo--opencart" aria-hidden="true">C</span>
            {% endif %}
            <span>{{ tech }}</span>
          </span>
          {% endfor %}
        </div>
      {% endif %}

      {% if project.data.company %}
        <p class="work-card-company">{{ project.data.company }}</p>
      {% endif %}

      <h3 class="work-card-title">
        {% if project.data.liveUrl %}
          <a href="{{ project.data.liveUrl }}" target="_blank" rel="noopener noreferrer">
            {{ project.data.title }}
          </a>
        {% else %}
          {{ project.data.title }}
        {% endif %}
      </h3>

      <p class="work-card-desc">
        {{ project.data.description }}
      </p>
    </div>
  </div>

</article>
