<article class="work-card">
  <div>
    <!-- Browser Mockup Frame -->
    <div class="browser-frame">
      <div class="browser-bar">
        <span class="browser-dot" aria-hidden="true"></span>
        <span class="browser-dot" aria-hidden="true"></span>
        <span class="browser-dot" aria-hidden="true"></span>
        <span class="browser-address">{{ project.data.previewUrl or "project.preview" }}</span>
        {% if project.data.liveUrl %}
          <span class="browser-action-indicator" aria-hidden="true">Visit site ↗</span>
        {% endif %}
      </div>
      <div class="browser-screen-wrapper">
        {% if project.data.thumbnail %}
          <img
            src="{{ project.data.thumbnail }}"
            alt="{{ project.data.thumbnailAlt or project.data.title }}"
            class="browser-screen-img"
            loading="lazy"
            width="800"
            height="450"
            onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'browser-screen-fallback\'>Project Preview</div>';"
          />
        {% else %}
          <div class="browser-screen-fallback">
            Project Preview
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Content -->
    <div class="work-card-content">
      {% if project.data.technologies and project.data.technologies.length > 0 %}
        <div class="tech-pills-row" aria-label="Technologies used">
          {% for tech in project.data.technologies %}
          <span class="tech-pill{% if tech == 'Webflow' %} tech-pill--webflow{% elif tech == 'WordPress' %} tech-pill--wordpress{% elif tech == 'OpenCart' %} tech-pill--opencart{% endif %}">
            {% if tech == 'Webflow' %}
              <span class="tech-pill-logo tech-pill-logo--webflow" aria-hidden="true">W</span>
            {% elif tech == 'WordPress' %}
              <span class="tech-pill-logo tech-pill-logo--wordpress" aria-hidden="true">W</span>
            {% elif tech == 'OpenCart' %}
              <span class="tech-pill-logo tech-pill-logo--opencart" aria-hidden="true">C</span>
            {% endif %}
            <span>{{ tech }}</span>
          </span>
          {% endfor %}
        </div>
      {% endif %}

      <h3 class="work-card-title">
        {% if project.data.liveUrl %}
          <a href="{{ project.data.liveUrl }}" target="_blank" rel="noopener noreferrer">
            {{ project.data.title }}
          </a>
        {% else %}
          {{ project.data.title }}
        {% endif %}
      </h3>

      <p class="work-card-desc">
        {{ project.data.description }}
      </p>
    </div>
  </div>

</article>
