<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__text">
        &copy; {% currentYear %} {{ site.name }}. {{ site.footer.text }}
      </p>
    </div>

    <ul class="site-footer__links" aria-label="Social and professional profiles">
      {% for item in site.socialLinks %}
        <li>
          <a href="{{ item.url }}" class="site-footer__link" target="_blank" rel="noopener noreferrer">
            {{ item.label }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</footer>
