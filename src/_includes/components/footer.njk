<footer class="site-footer">
  <div class="canvas-container site-footer__inner">
    <div>
      <p style="font-weight: 600; color: var(--text-on-surface); margin-bottom: 0.25rem;">
        {{ site.name }}
      </p>
      <p style="font-size: 0.8125rem; color: var(--text-muted);">
        &copy; {% currentYear %} {{ site.name }} &middot; Built with semantic HTML &amp; CSS
      </p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="#top">Back to Top ↑</a>
      {% for item in site.navigation %}
        <a href="{{ item.url }}">{{ item.label }}</a>
      {% endfor %}
    </nav>
  </div>
</footer>
