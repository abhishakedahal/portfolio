<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-logo" aria-label="{{ site.name }} - Homepage">
      <span class="site-logo__dot" aria-hidden="true"></span>
      <span>{{ site.name }}</span>
    </a>

    <button id="nav-toggle" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle navigation menu">
      Menu
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main Navigation">
      <ul class="site-nav__list">
        {% for item in site.navigation %}
          <li>
            <a href="{{ item.url }}" class="site-nav__link" {% if page.url == item.url %}aria-current="page"{% endif %}>
              {{ item.label }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
