<header class="site-header">
  <div class="canvas-container site-header__inner">
    <a href="#top" class="site-wordmark" aria-label="{{ site.wordmark }} - Back to top">
      {{ site.wordmark }}
    </a>

    <nav class="site-nav" aria-label="Main Navigation">
      <ul class="site-nav__list">
        {% for item in site.navigation %}
          <li>
            <a href="{{ item.url }}" class="site-nav__link">
              {{ item.label }}
            </a>
          </li>
        {% endfor %}
        <li>
          <a href="{{ site.author.github }}" class="site-nav__link site-nav__link--external" target="_blank" rel="noopener noreferrer">
            GitHub <span style="font-size: 0.75rem;">↗</span>
          </a>
        </li>
      </ul>
    </nav>

    <div>
      <a href="#contact" class="btn-header-cta">
        Get in Touch
      </a>
    </div>
  </div>
</header>
